#include <WiFi.h>
#include <HTTPClient.h>



// ======================================================
//                 WIFI CONFIG (MULTI)
// ======================================================

struct WifiCred {
  const char* ssid;
  const char* pass;
};

WifiCred WIFI_LIST[] = {
  {"ATUTEX CONFECTION 2", "ALTUTEX2030"},
  {"ALTUTEX CONFECTION 1",     "ALTUTEX2030"}
};

const int WIFI_COUNT = sizeof(WIFI_LIST) / sizeof(WIFI_LIST[0]);



// ======================================================
//                 API CONFIG (DUAL)
// ======================================================

const char* API_URLS[] = {
  "http://192.168.0.134:5000/api/machine_state",
  "http://192.168.1.134:5000/api/machine_state"
};

const int API_COUNT = sizeof(API_URLS) / sizeof(API_URLS[0]);

const char* MACHINE_ID = "M1";



// ======================================================
//                 GPIO CONFIG
// ======================================================

#define SIGNAL_OUTPUT_PIN 2   // provides HIGH
#define MACHINE_INPUT_PIN 4   // reads machine state



// ======================================================
//                 GLOBALS
// ======================================================

int lastState = -1;



// ======================================================
//            CONNECT TO ANY AVAILABLE WIFI
// ======================================================

bool connectToAnyWifi(uint32_t timeoutMsPerNet = 12000) {

  WiFi.mode(WIFI_STA);
  WiFi.disconnect(true);
  delay(300);

  for (int i = 0; i < WIFI_COUNT; i++) {

    Serial.printf("\nTrying WiFi: %s\n", WIFI_LIST[i].ssid);

    WiFi.begin(WIFI_LIST[i].ssid, WIFI_LIST[i].pass);

    uint32_t start = millis();
    while (WiFi.status() != WL_CONNECTED &&
           (millis() - start) < timeoutMsPerNet) {

      delay(300);
      Serial.print(".");
    }

    if (WiFi.status() == WL_CONNECTED) {

      Serial.printf("\n✅ Connected to: %s\n", WIFI_LIST[i].ssid);
      Serial.print("ESP32 IP: ");
      Serial.println(WiFi.localIP());

      return true;
    }

    Serial.println("\n❌ Failed, trying next WiFi...");
    WiFi.disconnect(true);
    delay(300);
  }

  Serial.println("\n❌ No WiFi network worked!");
  return false;
}



// ======================================================
//        SEND JSON TO ONE API URL (HELPER)
// ======================================================

bool postJson(const char* url, const String& payload) {

  HTTPClient http;
  http.setTimeout(2500);

  http.begin(url);
  http.addHeader("Content-Type", "application/json");

  int code = http.POST(payload);

  Serial.print("POST -> ");
  Serial.print(url);
  Serial.print(" | HTTP Code: ");
  Serial.println(code);

  http.end();

  return (code > 0 && code < 400);
}



// ======================================================
//              SEND STATE (FAILOVER)
// ======================================================

void sendState(int state) {

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("⚠️ WiFi disconnected, cannot send");
    return;
  }

  // Build JSON payload
  String payload = "{";
  payload += "\"machine_id\":\"" + String(MACHINE_ID) + "\",";
  payload += "\"state\":" + String(state);
  payload += "}";

  // Try API servers until one works
  for (int i = 0; i < API_COUNT; i++) {

    if (postJson(API_URLS[i], payload)) {
      Serial.println("✅ Sent successfully!\n");
      return;
    }

    Serial.println("❌ API failed, trying next...");
  }

  Serial.println("❌ All API servers failed!\n");
}



// ======================================================
//                     SETUP
// ======================================================

void setup() {

  Serial.begin(115200);
  delay(1000);

  // GPIO setup
  pinMode(SIGNAL_OUTPUT_PIN, OUTPUT);
  pinMode(MACHINE_INPUT_PIN, INPUT_PULLDOWN);

  // Always output HIGH
  digitalWrite(SIGNAL_OUTPUT_PIN, HIGH);

  // Connect WiFi
  Serial.println("\nConnecting to WiFi...");
  connectToAnyWifi();

  Serial.println("\nTouch GPIO2 and GPIO4 to simulate machine state");
}



// ======================================================
//                      LOOP
// ======================================================

void loop() {

  // Auto reconnect WiFi if dropped
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("⚠️ WiFi lost! Reconnecting...");
    connectToAnyWifi();
    delay(500);
    return;
  }

  // Read machine input state
  int currentState = digitalRead(MACHINE_INPUT_PIN);

  // Send ONLY when state changes
  if (currentState != lastState) {

    if (currentState == 1)
      Serial.println("MACHINE RUNNING (1)");
    else
      Serial.println("MACHINE STOPPED (0)");

    sendState(currentState);

    lastState = currentState;
  }

  delay(50); // debounce
}